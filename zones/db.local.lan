$TTL    86400
@       IN      SOA     ns1.lan.local. admin.lan.local. (
                              2026112101 ; Serial (AAAAMMDDNN)
                              3600       ; Refresh
                              900        ; Retry
                              604800     ; Expire
                              86400 )    ; Negative Cache TTL

@       IN      NS      ns1.lan.local.
ns1     IN      A       192.168.1.10
web     IN      A       192.168.1.20
app     IN      A       192.168.1.20
www     IN      CNAME   web.lan.local.
@       IN      MX  10  mail.lan.local.
mail    IN      A       192.168.1.30
@       IN      TXT     "v=spf1 a mx ~all"
